# Modelo de configuração do backend. Copie para ".env" e preencha os valores.
# O arquivo .env NUNCA deve ser versionado nem compartilhado (já está no .gitignore).

# ---------- Banco de dados (obrigatório) ----------
DB_HOST=localhost
# Usuário próprio da aplicação, com privilégio mínimo: SELECT, INSERT, UPDATE no banco
# assistencia_tecnica (e no assistencia_tecnica_teste, para os testes). A API não precisa de
# DELETE nem de DDL. Não use root. No ambiente local o usuário é "assistencia_app".
# Coloque a senha entre aspas simples se ela tiver "#" (o dotenv trata "#" como comentário).
DB_USER=assistencia_app
DB_PASSWORD=''
DB_NAME=assistencia_tecnica
# Porta do MySQL (padrão: 3306). Serviços externos costumam usar outra porta.
# DB_PORT=3306

# ---------- Banco de dados: produção / Vercel (opcional localmente) ----------
# true = conexão com SSL/TLS (exigido pela maioria dos serviços de MySQL externos)
# DB_SSL=true
# Certificado da autoridade (PEM) fornecido pelo provedor; aceita "\n" literais em uma linha
# DB_SSL_CA=
# false SOMENTE se o provedor não oferecer certificado verificável (padrão: true)
# DB_SSL_REJECT_UNAUTHORIZED=true
# Conexões por instância (padrão: 10 localmente, 3 na Vercel)
# DB_CONNECTION_LIMIT=3
# Fuso dos DATETIME: aplicado no driver e na sessão SQL (CURRENT_TIMESTAMP) de cada conexão.
# Padrão: "local" fora da Vercel (não altera a sessão) e -03:00 na Vercel.
# Obrigatório -03:00 em servidores que rodam em UTC, como o TiDB Cloud.
# DB_TIMEZONE=-03:00

# ---------- Testar o TiDB Cloud sem alterar este .env ----------
# 1. Crie backend/.env.tidb (já ignorado pelo Git por ".env.*"). Nunca versione esse arquivo.
# 2. Defina nele TODAS as variáveis DB_* abaixo: o que faltar é lido deste .env (banco local).
#      DB_HOST=<host do TiDB>         DB_PORT=4000
#      DB_USER=<prefixo>.<usuário>    DB_PASSWORD=<senha>
#      DB_NAME=assistencia_tecnica    DB_SSL=true
#      DB_TIMEZONE=-03:00             PORT=3001 (para rodar junto com o servidor local)
# 3. Inicie com "npm run start:tidb". "npm start" continua usando o banco local.
# NUNCA rode test:integracao, seed:usuarios ou migrações com o .env.tidb.

# Credencial ADMINISTRATIVA usada SOMENTE pelas ferramentas de teste e migração
# (backend/integracao: criam e apagam bancos *_teste e leem a estrutura do principal).
# A API não lê estas variáveis. NÃO inclua no .env de produção.
# DB_ADMIN_USER=
# DB_ADMIN_PASSWORD=''

# ---------- Servidor ----------
PORT=3000
# Origens do frontend autorizadas (separadas por vírgula). Padrão: http://localhost:4200
CORS_ORIGIN=http://localhost:4200

# ---------- Autenticação (obrigatório) ----------
# Segredo longo e aleatório (por exemplo, 64 caracteres). Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=1h
# Limite de tentativas de login com falha por IP (padrão: 5 tentativas em 15 minutos)
LOGIN_LIMITE_TENTATIVAS=5
LOGIN_LIMITE_JANELA_MIN=15

# ---------- Somente testes e ferramentas de banco (opcional) ----------
# Banco de testes (precisa terminar em "_teste"; padrão: <DB_NAME>_teste)
# DB_NAME_TESTE=assistencia_tecnica_teste
# 1 = manter o banco de testes ao final da integração (para visualização local)
# MANTER_BANCO_TESTE=1
# Pasta do cliente MySQL (padrão: C:\Program Files\MySQL\MySQL Server 8.0\bin)
# MYSQL_BIN=
# Login-path do mysql_config_editor para os scripts de backup e simulação
# MYSQL_LOGIN_PATH=
